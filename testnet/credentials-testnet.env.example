# Bitmark Explorer — TESTNET credentials
#
# Deploy to:  /home/server/etc-explorer/credentials-testnet.env   (chmod 600)
# Sourced by: run-bitmark-indexer-testnet.sh and run-bitmark-hp-gen-testnet.sh
#
#   cp credentials-testnet.env.example credentials-testnet.env
#   chmod 600 credentials-testnet.env
#   $EDITOR credentials-testnet.env
#
# Never commit the filled-in file — .gitignore covers credentials-*.env.

# ── Bitmark testnet node RPC ──────────────────────────────────────────────────
# Must match rpcuser/rpcpassword in /home/server/.bitmark-tn/bitmark.conf.
# Testnet RPC is 19266 (mainnet is 9266).
RPC_USER=bitmarkrpc
RPC_PASS=
RPC_PORT=19266

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Same database and same 'bitmark' role as mainnet — the testnet tables live in
# their own schema, so DB_SCHEMA is what keeps the two chains apart.
DB_PASS=
DB_NAME=bitmark
DB_SCHEMA=testnet
